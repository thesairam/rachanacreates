# SMTP credentials used by the /api/contact endpoint to send emails.
# Gmail with an App Password (requires 2-Step Verification enabled on the Google account).
# Generate the App Password at https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=hennabyrachana@gmail.com
SMTP_PASS=replace-with-16-char-app-password

# Address that receives the contact form emails. If not set, defaults to SMTP_USER.
TO_EMAIL=hennabyrachana@gmail.com

# Friendly "from" name on outgoing emails.
FROM_NAME=Henna By Rachana - Website

# Port the server listens on. DigitalOcean App Platform sets this automatically.
PORT=8080
